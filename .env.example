# ─── LLM ─────────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# ─── Web search (Tavily) ──────────────────────────────────────────────────────
# Free tier available at https://tavily.com
TAVILY_API_KEY=tvly-...

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
# 1. Create an app at https://clerk.com
# 2. Go to Configure → API Keys → copy the JWKS endpoint URL
#    Format: https://<your-clerk-domain>/.well-known/jwks.json
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use SQLite (local dev only).
# In production set to your Render Postgres or Neon connection string:
#   postgresql://user:password@host/dbname
DATABASE_URL=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, or * for dev.
# Production: set to your Vercel domain, e.g. https://munazara.manarattar.com
CORS_ORIGINS=https://munazara.manarattar.com

# ─── Error monitoring (Sentry) ────────────────────────────────────────────────
# Optional. Create a project at https://sentry.io and paste the DSN here.
# Leave empty to disable.
SENTRY_DSN=
